# Скопируй в .env. Установочный скрипт генерирует его сам

# адрес сервера без https://: 203-0-113-5.sslip.io или свой домен.
# На него Caddy получает сертификат, из него же ссылки для кабинета Meta
DIRECTOR_HOST=
# версия образов, например 0.1.0. Её меняет апдейтер
DIRECTOR_VERSION=

# hex, без спецсимволов: пароль подставляется в URL базы
POSTGRES_PASSWORD=
# ключ шифрования секретов в базе. Потеря ключа значит потерю токенов Instagram
SECRET_KEY=
# одноразовый токен регистрации владельца. После регистрации не нужен
SETUP_TOKEN=
