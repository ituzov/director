# Скопируй в .env. Установочный скрипт генерирует его сам
# hex, без спецсимволов: пароль подставляется в URL базы
POSTGRES_PASSWORD=
# ключ шифрования секретов в базе. Потеря ключа значит потерю токенов Instagram
SECRET_KEY=
# адрес сервера снаружи: https://203-0-113-5.sslip.io или свой домен
PUBLIC_URL=
