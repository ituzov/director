# Разработка: один вход для туннеля, маршруты как в проде.
# HTTPS делает туннель, сюда приходит обычный http
:8080 {
	# id запроса рождается на входе: по нему склеиваются логи Next, api и worker.
	# Пришедший снаружи X-Request-ID перезаписываем: клиенту в этом не доверяем
	request_header X-Request-ID {http.request.uuid}

	# вебхуки Meta мимо Next: им не нужна сессия, и web им не нужен
	handle /webhooks/* {
		reverse_proxy host.docker.internal:8000
	}
	handle {
		reverse_proxy host.docker.internal:3000
	}
}
